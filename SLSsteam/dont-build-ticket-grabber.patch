From 78d430728e5bb1d5bedd216a9bb18fe032ec2c5d Mon Sep 17 00:00:00 2001
From: HANDZCZ <handz@email.cz>
Date: Mon, 22 Jun 2026 12:17:00 +0200
Subject: [PATCH] Don't build ticket-grabber

ticket-grabber is not needed for SlSsteam compilation
---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 0ed1991..0b50bd0 100644
--- a/Makefile
+++ b/Makefile
@@ -30,7 +30,7 @@ ifeq ($(shell type mold &> /dev/null && echo "found"),found)
 	LDFLAGS += -fuse-ld=mold
 endif
 
-audit-libs: bin/SLSsteam.so bin/library-inject.so tools/ticket-grabber/bin/Release/net9.0/linux-x64/publish/ticket-grabber
+audit-libs: bin/SLSsteam.so bin/library-inject.so
 
 bin/SLSsteam.so: $(objs) $(libs)
 	@mkdir -p bin
-- 
2.54.0

